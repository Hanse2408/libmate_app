rules_version = '2';

// LibMate Firebase Storage security rules.
// Deploy: firebase deploy --only storage  (or paste into the Firebase
// console > Storage > Rules). The role check reads Firestore users/{uid};
// the console asks once to allow Storage rules to read Firestore.
service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
          in ['librarian', 'manager'];
    }

    // JPG, PNG or WebP, up to 5 MB (the app checks the same before upload).
    function validImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Book covers are not uploaded: they are images bundled in the app's
    // assets/images/books/ folder (Firestore books.coverAsset).

    // ebooks/{ebookId}/{timestamp}.pdf, PDF only, up to 25 MB.
    // Staff can read every PDF; other signed-in users (students) can only
    // download the PDF of a published e-book. Only staff can upload,
    // replace or delete.
    match /ebooks/{ebookId}/{fileName} {
      allow read: if isStaff()
        || (request.auth != null
          && firestore.get(/databases/(default)/documents/ebooks/$(ebookId)).data.status == 'published');
      allow create, update: if isStaff()
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isStaff();
    }

    // seat_images/{seatId}/{timestamp}.{ext}
    match /seat_images/{seatId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isStaff() && validImage();
      allow delete: if isStaff();
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
